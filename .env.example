# Copy to .env (git ignores it) and fill in what you use.

# Live streaming (npm run restream). Paste your platform's RTMP URL + stream key:
#   YouTube: rtmp://a.rtmp.youtube.com/live2/<stream key>
#   Twitch:  rtmp://live.twitch.tv/app/<stream key>
STREAM_URL=

# Commercials: your Amazon Associates tracking ID (added to every product link)
# AMAZON_TAG=yourname-20
# Minutes of airtime between commercial breaks (0 turns them off)
# AD_EVERY_MIN=10

# Optional: Claude writers' room instead of the local model
# ANTHROPIC_API_KEY=

# Optional: a different local model
# OLLAMA_MODEL=llama3.1:8b

# With a restream and nobody on the website we can't see the Twitch/YouTube audience, so the channel
# airs reruns except in these hours (local time; "19-23" = 7-11pm). Default: all day with the free
# local writer, never with Claude.
# FEED_FRESH_HOURS=19-23

# Show your Twitch chat in the website chat (moderated, labeled TWITCH) and let the cast react
# to it. Just your channel name - no key or password needed to read chat.
# TWITCH_CHANNEL=yourchannel

# Shoutouts (personalized videos viewers request for a friend) are free by default. To charge,
# create a payment link yourself (e.g. a Stripe Payment Link) and put it here; the request form
# shows it, and you approve requests on the desk once they've paid.
# SHOUTOUT_PAYMENT_URL=https://buy.stripe.com/...
# SHOUTOUT_PRICE=$15

# Real news on The 8-Bit Report: light stories (odd news, science, space) from public feeds, screened
# so tragedy, crime, politics and health claims never become a comedy bit, then fact-checked against
# the article. On by default; set NEWS_FEEDS=off to stop, or a comma-separated list of RSS feeds.
# NEWS_FEEDS=off
# NEWS_PER_DAY=6

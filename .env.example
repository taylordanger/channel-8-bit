# Copy to .env (git ignores it) and fill in what you use.

# Live streaming (npm run restream). Paste your platform's RTMP URL + stream key:
#   YouTube: rtmp://a.rtmp.youtube.com/live2/<stream key>
#   Twitch:  rtmp://live.twitch.tv/app/<stream key>
STREAM_URL=

# Optional: Claude writers' room instead of the local model
# ANTHROPIC_API_KEY=

# Optional: a different local model
# OLLAMA_MODEL=llama3.1:8b
